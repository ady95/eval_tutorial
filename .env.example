# .env.example 을 .env 로 복사한 뒤 값을 채우세요. .env 는 절대 커밋하지 않습니다.

# OpenAI API 키
OPENAI_API_KEY=sk-...

# (선택) OpenAI 호환 서버를 쓸 때만 주석(#)을 풀고 주소를 적습니다.
# 주석으로 두면 OpenAI 공식 API를 사용합니다.
# OPENAI_BASE_URL=http://localhost:11434/v1

# 답변을 만드는 모델(평가 대상)과 답변을 채점하는 모델(Judge)
OPENAI_MODEL=gpt-6-luna
OPENAI_MODEL_JUDGE=gpt-6-luna

# 임베딩 모델 (02장부터 사용). OpenAI 방식으로 호출할 수 있는 임베딩 서버와 모델
# OpenAI 임베딩을 쓰려면 EMBEDDING_BASE_URL 을 주석 처리하고 모델을 text-embedding-3-small 로 바꿉니다
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=bge-m3

# (06장) RAGAS 는 gpt-6-luna 같은 추론 모델에 temperature=1.0 을 붙여 보냅니다. OpenAI 공식 API(추론 강도가 none 이 아닐 때)와
# 일부 호환 서버는 이를 거부하므로, 적어 둔 파라미터를 RAGAS 요청에서 뺍니다. 추론 모델이 아닌 모델만 쓰면 지워도 됩니다.
OPENAI_DROP_PARAMS=temperature,top_p

# (08장) Agent 의 도구 호출에 붙이는 추론 강도. OpenAI 공식 API 의 gpt-6-luna 는 none 이 필요합니다.
# 추론 강도(reasoning_effort)를 받지 않는 모델이면 비워 둡니다.
AGENT_REASONING_EFFORT=none

# (07장) DeepEval 이 사용 통계를 외부로 보내지 않게 합니다
DEEPEVAL_TELEMETRY_OPT_OUT=YES

# (04-5, 06-7, 07-4) TypeSafe Jev API 키. Jev 실습은 별도 가상환경(.venv-jev)에서 합니다.
# Jev 를 쓰면 평가할 질문·답변·문서가 TypeSafe 의 외부 API 로 전송됩니다.
# TYPESAFE_API_KEY=

# (06-7) RAGAS-JEV 가 확신이 낮은 판정을 다시 볼 때 쓰는 LLM (지정하지 않으면 RAGAS-JEV 기본 모델)
# RAGAS_JEV_STRONG_JUDGE_MODEL=gpt-6-luna
# RAGAS_JEV_BASELINE_JUDGE_MODEL=gpt-6-luna

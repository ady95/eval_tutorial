# .env.example 을 .env 로 복사한 뒤 값을 채우세요. .env 는 절대 커밋하지 않습니다.

# OpenAI API 키
OPENAI_API_KEY=sk-...

# (선택) OpenAI 호환 서버를 쓸 때만 주석(#)을 풀고 주소를 적습니다.
# 주석으로 두면 OpenAI 공식 API를 사용합니다.
# OPENAI_BASE_URL=http://localhost:11434/v1

# 답변을 만드는 모델(평가 대상)과 답변을 채점하는 모델(Judge)
OPENAI_MODEL=gpt-6-luna
OPENAI_MODEL_JUDGE=gpt-6-luna
